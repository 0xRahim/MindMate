# MindMate environment — copy to .env and fill in.
# The compose file and mindmate.sh both read this file.
# If GEMINI_API_KEY is empty, the frontend uses its keyword fallback
# (no crash, just rule-based replies).
# Jules (long agentic tasks): needs JULES_API_KEY from
# https://jules.google.com/settings plus the connected repo source
# (GET /api/jules/sources lists available `sources/...` names).
# If JULES_API_KEY is empty, task-like messages fall back to Gemini.

GEMINI_API_KEY=
JULES_API_KEY=
JULES_SOURCE=
JULES_STARTING_BRANCH=main
FRONTEND_PORT=8080
TTS_PORT=5000
